# @trusted: watax framework core — audited byte-level parsing/reactor (raw-pointer systems code, like hyper/tokio internals).
# watax reactor — per-core coroutine event loop for many keep-alive
# connections per thread, without a thread per connection.
#
# Each reactor worker OS thread runs its own cooperative coroutine scheduler
# (Tauraro's `async def`/`await`/`Coro` runtime, itself driven by the OS's
# readiness multiplexer — epoll/kqueue/WSAPoll). One coroutine handles the
# accept loop; every accepted connection gets its OWN coroutine, running the
# SAME keep-alive request loop `App.listen()` already uses
# (`App._serve_conn`), just with the underlying `TcpStream` in `async_mode`
# so its `recv()`/`send()` cooperate with the scheduler instead of blocking
# the OS thread. This is the same architecture Tokio/axum use for their
# per-core workers: no separate handler thread pool, no cross-thread hop —
# request handling shares the SAME thread that already does the
# connection's I/O.
#
# Crucially, a route handler may now be `async def` and `await` other async
# calls (an outbound HTTP request, `Coro.sleep_ms`, anything built on the
# coroutine runtime) WITHOUT stalling this worker's other connections: while
# one connection's coroutine is suspended awaiting something, the scheduler
# runs any other ready coroutine on this same worker. A plain synchronous
# handler still works exactly as before, at the same cost as today.
#
# For genuinely CPU-heavy work, or a blocking call with no async equivalent,
# a handler can offload it onto `AsyncPool` (`std.async.pool`) and
# cooperatively wait for the result with `while not task.done():
# Coro.yield_now()` — NOT `task.join()`, which is a real OS-level blocking
# wait and would stall this whole worker, defeating the point. That's a
# secondary, opt-in outlet, not the default path.
#
# watax previously had a coroutine-per-connection mode (`listen_async`) that
# was removed for racing: it shared the App across worker OS threads via a
# raw, unsynchronized global variable. That mechanism (not the coroutine
# model itself) was the bug — this version reaches the same App safely via
# the existing per-worker `Mutex[App]` handoff (`ReactorWorker`, unchanged)
# plus a `ThreadLocal[Pointer[char]]` raw-pointer slot to make that
# already-safe, thread-owned value reachable from the coroutines spawned on
# that same thread (see `_tl_app`'s own comment for why it's a raw pointer,
# not `ThreadLocal[App]`).

from std.net.http_server import HttpServer, HttpConn
from std.net.tcp import TcpStream, TcpListener
from std.async.coro import Coro
from std.async.thread import Thread, ThreadLocal
from std.async.mutex import Mutex
from std.async.send import Sendable
from std.sys.signal import Signal
from std.string.str import Str
from app import App

# One reactor worker: its own coroutine scheduler + connections, sharing the
# App's (read-only after setup) route table and one listening socket with
# the other workers.
class ReactorWorker implements Sendable, UnsafeSendable:
    pub app:      Mutex[App]
    pub listener: Mutex[TcpListener]

extend ReactorWorker:
    pub def init(app: App, listener: TcpListener) -> ReactorWorker:
        mut w = ReactorWorker()
        w.app      = Mutex[App].init(app)
        w.listener = Mutex[TcpListener].init(listener)
        return w

# Per-worker-thread handle to that thread's own App, set once by
# `_reactor_run` and read by every coroutine it spawns on the same OS
# thread. Stored as a raw `Pointer[char]`, NOT `ThreadLocal[App]`: a
# ref-counted class value round-tripped through `ThreadLocal[T].get()`
# is not reliably retained (confirmed with a real crash — see
# `_app()`'s comment below), so every read here is an explicit `unsafe`
# pointer cast instead, deliberately opting out of the compiler's normal
# ARC bookkeeping for it (correct here since the underlying App is kept
# alive independently, by `_reactor_run`'s own `app` local, for the whole
# worker lifetime — every coroutine's use is strictly nested inside that).
mut _tl_app: ThreadLocal[Pointer[char]] = ThreadLocal.new(0 as Pointer[char])

# Fetch this worker thread's App from `_tl_app`. ALWAYS use the result of
# this call inline (as a receiver or argument) — never bind it to a named
# local (`mut app = _app()`). Binding it to a name makes the compiler treat
# it as a fresh owned value and insert an auto-drop when that name goes out
# of scope, which releases a reference that was never actually retained;
# with `App` alive for the worker's entire lifetime (not a throwaway local),
# that manifests as a random, delayed heap-corruption crash once enough
# connections have been handled — reproduced directly with
# `ThreadLocal[App]` (compiles fine after the cast fix in
# `src/codegen/c.tr`'s `ThreadLocal.get()` dispatch, but is not ARC-safe for
# a class T) and confirmed fixed only once the value was (a) stored as a raw
# `Pointer[char]` and (b) cast back to `App` inline, never named, at each
# use site (tauraro repo: `scratch/test_tls_ptr_realistic.tr`, clean across
# 2.5M stress-test iterations).
def _app() -> App:
    unsafe: return _tl_app.get() as App

# Build a connected, non-blocking, coroutine-aware TcpStream from a raw fd
# accepted by this worker's listener.
def _make_async_stream(fd: int) -> TcpStream:
    mut s = TcpStream()
    s.fd          = fd
    s.connected   = true
    s.async_mode  = true
    s.host        = ""
    s.port        = 0
    # `TcpListener.accept_nb()` already put the OS-level socket in
    # non-blocking mode as a side effect of accepting it, but that call's
    # own TcpStream wrapper is discarded (only its raw fd crosses into this
    # coroutine) - explicitly re-assert it here via the real method (not
    # just `s.nonblocking = true`, which only sets the bookkeeping field
    # and does NOT call the underlying ioctlsocket/fcntl) so this is correct
    # by construction regardless of what accept_nb() did.
    s.set_nonblocking()
    return s

# Per-connection coroutine: read the first request, then run the SAME
# keep-alive dispatch loop `App.listen()` uses (`App._serve_conn`) — it is
# already fully async-mode-transparent (every I/O call goes through
# `stream.recv()`/`.send()`, which redirect to the cooperative
# `recv_async`/`send_async` when `async_mode` is set), so no separate
# reactor-specific dispatch path is needed here. Every `_app()` call below
# is used inline, never bound to a named local — see `_app()`'s own comment
# for why that matters.
def _handle_connection(arg: Pointer[char]):
    mut fd: int = 0
    unsafe: fd = arg as int
    mut stream = _make_async_stream(fd)
    # HttpRequest self-manages its memory (an explicit `free()` — really
    # `free_owned()`, see its own comment — that HttpConn.close() calls once
    # `conn` owns it). Binding the read_next() result to a named
    # `HttpRequest`-typed local would ALSO get an auto-drop call inserted at
    # this function's end (the compiler destructs any class-typed local that
    # has a `free()` method, regardless of whether it was handed off to a
    # longer-lived owner in between) — since `conn.request` IS this same
    # object, that auto-drop is a second, unconditional call to the same
    # free(), i.e. a real double-free (confirmed via AddressSanitizer).
    # Same raw-pointer, never-bind-to-a-typed-name workaround as `_app()`
    # above sidesteps it: the compiler never auto-drops a `Pointer[char]`.
    mut req_ptr = _app()._server.read_next(stream) as Pointer[char]
    if Str.len((req_ptr as HttpRequest).method) == 0:
        stream.close()
        return
    mut conn = HttpConn.init(req_ptr as HttpRequest, stream)
    App._serve_conn(_app(), conn)

# Accept loop coroutine (one per worker): non-blocking accept, polling the
# listener between connections. (`TcpListener.accept_async()` has a known
# compiler bug returning a class instance across a coroutine park — this is
# the documented inline workaround from its own doc comment in
# std/net/tcp.tr.) Spawns one coroutine per accepted connection.
def _accept_loop(arg: Pointer[char]):
    mut lfd: int = 0
    unsafe: lfd = arg as int
    mut listener = TcpListener()
    listener.fd        = lfd
    listener.listening = true
    listener.host      = ""
    listener.port      = 0
    while listener.is_listening() and not Signal.shutdown_requested():
        mut s = listener.accept_nb()
        if s.fd >= 0:
            unsafe: Coro.spawn(_handle_connection as Pointer[char], s.fd as Pointer[char])
        else:
            # `Coro.await_readable(lfd)` parks this coroutine on the reactor
            # until the listening socket itself reports readiness, with no
            # other built-in wakeup source: the scheduler only re-examines a
            # parked coroutine's own code (including the
            # `Signal.shutdown_requested()` check above) when ITS registered
            # fd gets an event, and `_tr_install_shutdown_handler`'s SIGINT/
            # SIGTERM handler only flips a flag (no self-pipe/eventfd to
            # interrupt an in-flight epoll_wait/kevent). An EARLIER version of
            # this fix replaced this wait with a bounded `Coro.sleep_ms(50)`
            # poll to guarantee the flag gets re-checked - that broke the
            # zero-latency accept path badly (confirmed via CI: throughput
            # dropped ~45% across every endpoint, since wrk opens a fresh
            # burst of connections per endpoint and each burst could now
            # stall up to 50ms waiting for the next poll). Kept the fast,
            # purely event-driven wait here; shutdown responsiveness is
            # instead handled out-of-band by `_shutdown_watchdog` below,
            # which forces a real wakeup via a loopback connect once shutdown
            # is actually requested - zero cost while running normally.
            Coro.await_readable(lfd)
    print("watax: worker shutting down")

# Runs on its OWN dedicated OS thread (NOT a coroutine - a plain blocking
# `Thread.sleep` here is fine, since this thread does nothing else). Every
# worker's accept loop is parked in `Coro.await_readable(lfd)` with no
# wakeup source but a real event on the shared listening socket (see
# `_accept_loop`'s comment) - once `Signal.shutdown_requested()` flips, open
# one real loopback connection per worker to force that: multiple reactor
# workers share ONE listening socket, and each worker's own epoll/kqueue
# instance independently observes readiness on it, so a small burst of real
# connections reliably wakes every worker's accept loop (only one accepts
# each dummy connection; the rest see WOULD_BLOCK, loop back to `while`, and
# exit on the now-true flag - harmless either way).
#
# Only `port`/`workers` (both `int`) cross the `Thread.spawn` boundary, not
# `host`: passing a plain `str` (or a class wrapping one, even Mutex[str])
# through `Thread.spawn` hits real codegen bugs in the currently-released
# compiler (TrStr is a 2-word struct, and several "box T into one word" call
# sites assume a scalar). Always dialing "127.0.0.1" sidesteps that
# entirely - correct for a listener bound to "127.0.0.1" or "0.0.0.0" (the
# loopback interface is reachable either way, which covers every example and
# the benchmark harness in this repo); a listener bound to one specific
# non-loopback IP would need the real host, which isn't worth the compiler
# fix/release just for this watchdog.
#
# Poll interval is 2s, not something tighter like 200ms: this thread runs
# for the server's entire lifetime, and even a cheap, mostly-sleeping extra
# OS thread adds one more scheduling participant competing with the reactor
# workers for the same cores - measured as a real, consistent 4-16% throughput
# drop across every benchmark endpoint at 200ms (worse on cheap endpoints,
# consistent with a small fixed per-wakeup cost) versus the pre-watchdog
# baseline. 2s still bounds shutdown latency to something trivial for a
# process exit, while waking 10x less often.
def _shutdown_watchdog(port: int, workers: int):
    while not Signal.shutdown_requested():
        Thread.sleep(2000)
    mut i = 0
    while i < workers:
        mut s = TcpStream.connect("127.0.0.1", port)
        s.close()
        i = i + 1

def _reactor_run(w: Shared[ReactorWorker]):
    mut app      = w.app.get()
    mut listener = w.listener.get()
    # `app` stays alive for this whole function (until `Coro.run()` returns
    # at worker shutdown), so every coroutine spawned below - which all run
    # to completion strictly before this function does - can safely borrow
    # it via `_tl_app`/`_app()` for their own, shorter-lived duration.
    unsafe: _tl_app.set(app as Pointer[char])
    unsafe: Coro.spawn(_accept_loop as Pointer[char], listener.fd as Pointer[char])
    Coro.run()

extend App:
    # Single-threaded reactor: handles many keep-alive connections on one
    # thread via a per-connection coroutine (see the module doc comment
    # above for the full model).
    pub def listen_reactor(self, host: str, port: int):
        App.listen_reactor_pool(self, host, port, 1)

    # `workers` reactor threads share one listening socket, each running its
    # own coroutine scheduler over its own connections (new connections are
    # distributed across workers by the OS - accept_nb from multiple threads
    # on the same listening socket is safe: each call either gets a
    # connection or WOULD_BLOCK).
    #
    # Ctrl+C (SIGINT) or SIGTERM trips a shared flag each worker's accept
    # loop checks between accepts, so the process exits promptly without
    # cutting off connections already being served.
    pub def listen_reactor_pool(self, host: str, port: int, workers: int):
        self._server = HttpServer.init(host, port)
        App._configure_server(self)
        if not self._server.start():
            print("watax: failed to bind " + host + ":" + port.to_str())
            return
        self._server._listener.set_nonblocking()
        Signal.install_shutdown_handler()
        print("watax listening (reactor, " + workers.to_str() + " workers) on http://" + host + ":" + port.to_str())
        mut watchdog = Thread.spawn(_shutdown_watchdog, port, workers)
        watchdog.detach()
        mut i = 1
        while i < workers:
            shared rw = ReactorWorker.init(self, self._server._listener)
            mut t = Thread.spawn(_reactor_run, rw.clone())
            t.detach()
            i = i + 1
        shared rw0 = ReactorWorker.init(self, self._server._listener)
        _reactor_run(rw0)
